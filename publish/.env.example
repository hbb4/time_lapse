# Copy to ~/.config/time_lapse/publish/.env (or the repo root as .env; it is git-ignored) and fill in what you use.
# Real environment variables win over this file.

# YouTube: Google Cloud console > APIs & Services > enable "YouTube Data API v3" > Credentials > OAuth client ID (Desktop app)
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# TikTok: developers.tiktok.com > Manage apps > add the Content Posting API product (Direct Post on)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# must match a redirect URI registered in the TikTok app (the default works for a localhost one)
# TIKTOK_REDIRECT_URI=http://localhost:8765/callback

# Instagram + Facebook: developers.facebook.com > a Business app; one login (`auth meta`) covers both
META_APP_ID=
META_APP_SECRET=
# optional: skip `auth meta` and set these directly
# META_PAGE_TOKEN=
# FB_PAGE_ID=
# IG_USER_ID=

# X: developer.x.com > a project/app with OAuth 2.0 (user authentication) turned on
X_CLIENT_ID=
X_CLIENT_SECRET=

# Notifications (pick the channels per account in settings.toml; see notify.channels)
# Telegram: message @BotFather > /newbot for the token; send your bot any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id (put it in settings.toml as notify.telegram.chat_id)
TELEGRAM_BOT_TOKEN=
# Discord: channel settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=
# ntfy (optional access token for a protected topic; the topic itself goes in settings.toml)
NTFY_TOKEN=
